# Copy to .env and fill in real values. Never commit .env.
# Every value here is a secret or a credential: store them in Bitwarden and
# paste them in at deploy time rather than writing them into this repository.

# REQUIRED. PostgreSQL connection string. Without it the server refuses to
# start in production, because enquiries would be lost on every restart.
DATABASE_URL=

# Optional. Connection pool ceiling. Defaults to 5.
DATABASE_POOL_MAX=5

# REQUIRED for the admin enquiry API. Send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
# If unset, /api/booking-enquiries returns 503 rather than serving PII openly.
ADMIN_API_TOKEN=

# REQUIRED in practice. Where a new enquiry is delivered: an email bridge, a
# chat channel webhook, or a CRM intake endpoint. Best-effort -- a failure is
# logged and never loses the enquiry, which is already stored by then.
OPERATOR_WEBHOOK_URL=

# Optional. Sent as a bearer token to the webhook above.
OPERATOR_WEBHOOK_SECRET=